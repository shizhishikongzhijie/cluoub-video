{
  "name": "@cluoub-design/cluoub-video",
  "version": "1.0.0",
  "type": "module",
  "description": "一个现代化、可定制的 React 视频播放器组件，带有弹幕系统、字幕支持和快捷键功能",
  "keywords": [
    "react",
    "video",
    "player",
    "component",
    "barrage",
    "ui",
    "subtitles",
    "shortcuts"
  ],
  "author": "Cluoub Design Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cluoub-design/cluoub-video.git"
  },
  "bugs": {
    "url": "https://github.com/cluoub-design/cluoub-video/issues"
  },
  "homepage": "https://github.com/cluoub-design/cluoub-video#readme",
  "main": "dist/index.cjs.js",
  "module": "dist/index.mjs.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs.js",
      "require": "./dist/index.cjs.js"
    },
    "./dist/cluoub-video.css": {
      "import": "./dist/cluoub-video.css",
      "require": "./dist/cluoub-video.css"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "lucide-react": "^0.544.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/node": "^18.19.124",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^5.0.3",
    "babel-plugin-react-compiler": "^19.1.0-rc.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "rollup-plugin-dts": "^6.2.3",
    "rollup-plugin-visualizer": "^6.0.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0",
    "vite": "npm:rolldown-vite@7.1.12",
    "vite-plugin-dts": "^4.5.4"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@7.1.12"
    }
  }

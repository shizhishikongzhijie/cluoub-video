{
  "name": "@cluoub-design/cluoub-video",
  "version": "0.3.0-beta.2",
  "type": "module",
  "description": "一个现代化、可定制的 React 视频播放器组件，带有弹幕系统、字幕支持和快捷键功能",
  "keywords": [
    "react",
    "video",
    "player",
    "component",
    "barrage",
    "ui",
    "subtitles",
    "shortcuts"
  ],
  "author": "shizhishi",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shizhishikongzhijie/cluoub-video.git"
  },
  "bugs": {
    "url": "https://github.com/shizhishikongzhijie/cluoub-video/issues"
  },
  "homepage": "https://github.com/shizhishikongzhijie/cluoub-video#readme",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.cjs"
    },
    "./plugins/subtitle": {
      "types": "./dist/plugins/subtitle/index.d.ts",
      "import": "./dist/plugins/subtitle.mjs",
      "require": "./dist/plugins/subtitle.cjs"
    },
    "./plugins/dash": {
      "types": "./dist/plugins/dash/index.d.ts",
      "import": "./dist/plugins/dash.mjs",
      "require": "./dist/plugins/dash.cjs"
    },
    "./plugins/hls": {
      "types": "./dist/plugins/hls/index.d.ts",
      "import": "./dist/plugins/hls.mjs",
      "require": "./dist/plugins/hls.cjs"
    },
    "./plugins/danmu": {
      "types": "./dist/plugins/danmu/index.d.ts",
      "import": "./dist/plugins/danmu.mjs",
      "require": "./dist/plugins/danmu.cjs"
    },
    "./plugins/capture": {
      "types": "./dist/plugins/capture/index.d.ts",
      "import": "./dist/plugins/capture.mjs",
      "require": "./dist/plugins/capture.cjs"
    },
    "./styles.css": {
      "import": "./dist/cluoub-video.css",
      "require": "./dist/cluoub-video.css"
    },
    "./dist/cluoub-video.css": {
      "import": "./dist/cluoub-video.css",
      "require": "./dist/cluoub-video.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:lib && pnpm run build:demo",
    "build:lib": "vite build",
    "build:demo": "vite build --config vite.demo.config.ts",
    "check:exports": "node scripts/check-package.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check:types": "tsc -p type-tests/tsconfig.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "pages:gitee:prepare": "node scripts/prepare-gitee-pages.mjs",
    "pages:gitee:publish": "node scripts/publish-gitee-pages.mjs"
  },
  "peerDependencies": {
    "dashjs": "^4.7.4",
    "hls.js": "^1.5.0",
    "libjass": "^0.11.0",
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "dashjs": {
      "optional": true
    },
    "hls.js": {
      "optional": true
    },
    "libjass": {
      "optional": true
    }
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "gifenc": "^1.0.3",
    "lucide-react": "^0.544.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.62.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.16.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "babel-plugin-react-compiler": "19.1.0-rc.3",
    "eslint": "^9.37.0",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.4.0",
    "jsdom": "^29.1.1",
    "libjass": "^0.11.0",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.2.0",
    "prettier-plugin-packagejson": "^2.5.19",
    "rollup-plugin-dts": "^6.2.3",
    "rollup-plugin-visualizer": "^6.0.4",
    "sass-embedded": "^1.97.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.46.1",
    "vite": "npm:rolldown-vite@7.1.12",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@7.1.12"
    }
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ]
}
